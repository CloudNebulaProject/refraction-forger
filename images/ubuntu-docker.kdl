metadata name="ubuntu-docker" version="1.0.0" description="Ubuntu 22.04 VM with Docker"

distro "ubuntu-22.04"

repositories {
    apt-mirror "http://archive.ubuntu.com/ubuntu" suite="jammy" components="main universe"
    apt-mirror "http://archive.ubuntu.com/ubuntu" suite="jammy-updates" components="main universe"
    apt-mirror "http://archive.ubuntu.com/ubuntu" suite="jammy-security" components="main universe"
}

packages {
    // Core system
    package "linux-image-generic"
    package "initramfs-tools"
    package "grub-efi-amd64"
    package "openssh-server"
    package "cloud-init"
    package "cloud-guest-utils"
    package "ca-certificates"
    package "curl"
    package "gnupg"

    // Docker (from Ubuntu universe — docker.io is the distro-maintained package)
    package "docker.io"
    package "docker-compose"
    package "containerd"

    // Utilities
    package "git"
    package "jq"
    package "htop"
    package "vim"
    package "sudo"
}

customization {
    user "admin"
}

overlays {
    // Set root password
    shadow username="root" password="$5$kr1VgdIt$OUiUAyZCDogH/uaxH71rMeQxvpDEY2yX.x0ZQRnmeb9"

    // Admin user setup
    ensure-dir "/home/admin" owner="admin" group="admin" mode="755"
    ensure-dir "/home/admin/.ssh" owner="admin" group="admin" mode="700"
    file destination="/etc/sudoers.d/admin" source="ubuntu-docker/sudoers-admin"

    // --- Initramfs: include virtio drivers for VM boot ---
    file destination="/etc/initramfs-tools/modules" source="ubuntu-docker/initramfs-modules"

    // --- Serial console ---
    // GRUB: output to both VGA and serial (ttyS0 @ 115200)
    file destination="/etc/default/grub" source="ubuntu-docker/grub-default"
    // Systemd serial getty on ttyS0
    file destination="/etc/systemd/system/serial-getty@ttyS0.service" source="ubuntu-docker/serial-getty-ttyS0.conf"
    // Enable the serial getty (symlink into getty.target.wants)
    ensure-dir "/etc/systemd/system/getty.target.wants" owner="root" group="root" mode="755"
    ensure-symlink "/etc/systemd/system/getty.target.wants/serial-getty@ttyS0.service" target="/etc/systemd/system/serial-getty@ttyS0.service"

    // --- Cloud-init: clean state so it re-runs on first boot ---
    // Remove instance state from the build
    remove-files dir="/var/lib/cloud"
    // Re-create empty directory structure cloud-init expects
    ensure-dir "/var/lib/cloud" owner="root" group="root" mode="755"
    // Datasource configuration
    file destination="/etc/cloud/cloud.cfg.d/90_dpkg.cfg" source="ubuntu-docker/cloud-init-datasources"

    // Remove SSH host keys (cloud-init regenerates them on first boot)
    remove-files pattern="/etc/ssh/ssh_host_*"

    // Truncate machine-id so systemd regenerates it on first boot
    file destination="/etc/machine-id"
}

builder {
    image "https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img"
    vcpus 4
    memory 4096
    disk 20
}

target "qcow2" kind="qcow2" {
    disk-size "10G"
    bootloader "grub"
    filesystem "ext4"
    push-to "code.aopc.cloud/cloudnebulaproject/ubuntu-docker:latest"
}
